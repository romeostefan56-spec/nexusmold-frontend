{
  "id": "nexusmold-cloud",
  "name": "NexusMold Cloud",
  "short_name": "NexusMold",
  "description": "Control de presencia, obras y gestión de operarios del taller.",
  "lang": "es",
  "dir": "auto",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0f172a",
